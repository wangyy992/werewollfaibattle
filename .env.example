# Copy this file to .env.local and fill in your key.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Required. An OpenAI-compatible API key; by default the app talks to DeepSeek.
# Get one at https://platform.deepseek.com
VITE_DEEPSEEK_API_KEY="sk-your-key-here"

# Optional. Point the client at another OpenAI-compatible endpoint.
# VITE_AI_BASE_URL="https://api.deepseek.com"
# VITE_AI_MODEL="deepseek-chat"
